{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "ESNext.String",
      "DOM"
    ]
  },
  "include": [
    "tests/fixtures/engines/**/*.mts",
    "tests/fixtures/engines/**/*.ts",
    "src/service/**/*.ts",
    "tests/service/**/*.ts",
    "tests/proof/**/*.ts",
    "tests/proof/**/*.mts"
  ]
}
