#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
# Keep the historical no-argument proof available until member cutover is approved.
if [ "$#" -eq 0 ]; then exec scripts/verify-legacy; fi
for option do
  case "$option" in
    --engine|--engine=*|fixture|--mode=fixture) exec scripts/verify-members "$@" ;;
  esac
done
exec scripts/verify-legacy "$@"
